<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cài đặt quyền riêng tư"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/mdx_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp">

        <!-- Toggle Danh sách phát -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hiển thị Danh sách phát"
                android:textSize="16sp"
                android:textColor="@color/mdx_text" />

            <Switch
                android:id="@+id/switch_show_playlists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Toggle Nghệ sĩ đã nghe gần đây -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hiển thị Nghệ sĩ đã nghe gần đây"
                android:textSize="16sp"
                android:textColor="@color/mdx_text" />

            <Switch
                android:id="@+id/switch_show_recent_artists"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- === NÚT HỦY & LƯU - BO GÓC GIỐNG NHAU === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:gravity="center_vertical">

        <!-- Nút Hủy -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Hủy"
            android:textColor="@color/mdx_text_secondary"
            app:strokeColor="@color/mdx_line"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <!-- Nút Lưu thay đổi -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Lưu thay đổi"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/mdx_primary"
            app:cornerRadius="12dp"
            android:layout_marginStart="8dp" />

    </LinearLayout>
</LinearLayout>